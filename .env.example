# ---------------------------------------------------------------------------
# Supabase (required)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
# Server only. Never expose with a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ---------------------------------------------------------------------------
# Admin area (required, there are NO defaults: without them /admin stays closed)
# ADMIN_MASTER_PIN: AT LEAST 6 characters (a shorter PIN keeps the admin area closed with
#   "Admin paneli sozlanmagan"), second factor after logging in as super_admin
# ADMIN_SESSION_SECRET: random string, 32+ chars (openssl rand -hex 32)
# ---------------------------------------------------------------------------
ADMIN_MASTER_PIN=
ADMIN_SESSION_SECRET=
# Optional: only these client IPs may reach /admin and /api/v1/admin (comma separated). Empty = no
# IP restriction. Everyone else gets a plain 404. Only use behind a proxy that sets
# x-forwarded-for itself (Vercel does).
ADMIN_ALLOWED_IPS=

# ---------------------------------------------------------------------------
# AI image generation. Leave all empty = demo mode (no live generation).
# Every key below is optional; add any and live generation switches on automatically.
# Models of ALL configured providers are ranked by quality and tried strongest first. When every
# key of a provider is rate limited / out of credit, the next model takes over automatically.
# List variables accept several keys separated by commas (rotated round-robin).
#   Gemini (image editing)  OpenRouter (GPT Image, Seedream, FLUX, Hunyuan, Muse, ...)
#   Fal.ai   OpenAI (text-to-image only, last resort)
# NOTE: OpenRouter image models and Gemini image models need a PAID account (OpenRouter credits,
# Google AI billing). Free-tier keys authenticate but every image call returns 402 / 429.
# ---------------------------------------------------------------------------
GEMINI_API_KEY=
# Gemini model used for product translation and text improvement (default: gemini-3.1-flash-lite)
GEMINI_MODEL=
# Optional extra Gemini keys, comma separated
GEMINI_API_KEYS=
OPENROUTER_API_KEYS=
FAL_KEY=
# (FAL_MODEL is ignored: the chain ranks Fal endpoints itself)
OPENAI_API_KEY=
# Optional: extra https hosts the server may download images from (comma separated)
AI_IMAGE_HOST_ALLOWLIST=
# Required only if you use Fal queue webhooks (the endpoint is closed without it)
FAL_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# SMS verification via Eskiz.uz. Leave empty until you top up the account:
# registration works without SMS. Set both and phone OTP turns on automatically.
# ---------------------------------------------------------------------------
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
ESKIZ_SENDER=4546
# Optional secret for hashing OTP codes (falls back to the service role key)
OTP_HASH_SECRET=

# ---------------------------------------------------------------------------
# 3% booking deposit: the card customers send the deposit to (shown in the app).
# Without these, the booking page says the payment details are not configured.
# ---------------------------------------------------------------------------
ESCROW_CARD_NUMBER=
ESCROW_CARD_HOLDER=
ESCROW_BANK=

# ---------------------------------------------------------------------------
# Telegram bot: admin gets each deposit receipt with Approve / Reject buttons.
# Token from @BotFather (never commit it). Chat ids: comma separated numeric ids.
# Register the webhook once: node scripts/telegram-set-webhook.mjs https://your-domain
# ---------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_IDS=
TELEGRAM_WEBHOOK_SECRET=
# profiles.id of the super_admin recorded in the audit log for Telegram decisions
TELEGRAM_ADMIN_PROFILE_ID=

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# SEO: public origin used for canonical URLs, sitemap, Open Graph. Change only this when a custom domain is attached.
NEXT_PUBLIC_SITE_URL=https://car-vision-omega.vercel.app
# Search engine ownership verification (optional)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_YANDEX_VERIFICATION=
NEXT_PUBLIC_BING_VERIFICATION=

# ---------------------------------------------------------------------------
# Optional: choose the AI models per task (comma separated `provider:model`, strongest preference
# first; everything else stays as automatic fallback). Providers: gemini, openrouter, fal, openai.
#   IMAGE_MODEL_FITMENT=gemini:gemini-3.1-flash-image,gemini:gemini-3-pro-image-preview
#   IMAGE_MODEL_VIDEO_FRAME=gemini:gemini-3.1-flash-image
# Default (nothing set): Nano Banana 2 first, Nano Banana Pro as fallback, then the other providers.
# Text models: GEMINI_TEXT_MODEL (translation, product text), GEMINI_DETECT_MODEL (car identification).
# ---------------------------------------------------------------------------
IMAGE_MODEL_FITMENT=
IMAGE_MODEL_VIDEO_FRAME=
GEMINI_TEXT_MODEL=
GEMINI_DETECT_MODEL=

# ---------------------------------------------------------------------------
# Optional: require the photo check before any credit is spent. When set (16+ random characters,
# for example `openssl rand -hex 24`), /api/v1/generations only renders for a signed-in user who
# passed the car check (a car, all sides the same car) in the last 6 hours. Empty = not enforced.
# ---------------------------------------------------------------------------
CAR_CHECK_SECRET=

# ---------------------------------------------------------------------------
# Output size of the rendered pictures (Gemini 3 image models): 1K, 2K or 4K. Default 2K (sharper
# on desktop, Nano Banana 2 costs about $0.067 at 1K, $0.101 at 2K, $0.151 at 4K per picture).
#   IMAGE_SIZE_FITMENT=2K
#   IMAGE_SIZE_VIDEO_FRAME=2K
# Newer model if you want to try it (Google calls it the recommended one for new projects):
#   IMAGE_MODEL_FITMENT=gemini:gemini-nano-banana-2.1,gemini:gemini-3.1-flash-image
# ---------------------------------------------------------------------------
IMAGE_SIZE_FITMENT=
IMAGE_SIZE_VIDEO_FRAME=
