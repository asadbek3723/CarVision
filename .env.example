# ---------------------------------------------------------------------------
# Supabase (required)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
# Server only. Never expose with a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ---------------------------------------------------------------------------
# Admin area (required, there are NO defaults: without them /admin stays closed)
# ADMIN_MASTER_PIN: 6+ digits, second factor after logging in as super_admin
# ADMIN_SESSION_SECRET: random string, 32+ chars (openssl rand -hex 32)
# ---------------------------------------------------------------------------
ADMIN_MASTER_PIN=
ADMIN_SESSION_SECRET=
# Optional: only these client IPs may reach /admin and /api/v1/admin (comma separated). Empty = no
# IP restriction. Everyone else gets a plain 404. Only use behind a proxy that sets
# x-forwarded-for itself (Vercel does).
ADMIN_ALLOWED_IPS=

# ---------------------------------------------------------------------------
# AI image generation. Leave all empty = demo mode (no live generation).
# Every key below is optional; add any and live generation switches on automatically.
# Models of ALL configured providers are ranked by quality and tried strongest first. When every
# key of a provider is rate limited / out of credit, the next model takes over automatically.
# List variables accept several keys separated by commas (rotated round-robin).
#   Gemini (image editing)  OpenRouter (GPT Image, Seedream, FLUX, Hunyuan, Muse, ...)
#   Fal.ai   OpenAI (text-to-image only, last resort)
# NOTE: OpenRouter image models and Gemini image models need a PAID account (OpenRouter credits,
# Google AI billing). Free-tier keys authenticate but every image call returns 402 / 429.
# ---------------------------------------------------------------------------
GEMINI_API_KEY=
# Optional extra Gemini keys, comma separated
GEMINI_API_KEYS=
OPENROUTER_API_KEYS=
FAL_KEY=
# (FAL_MODEL is ignored: the chain ranks Fal endpoints itself)
OPENAI_API_KEY=
# Optional: extra https hosts the server may download images from (comma separated)
AI_IMAGE_HOST_ALLOWLIST=
# Required only if you use Fal queue webhooks (the endpoint is closed without it)
FAL_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# SMS verification via Eskiz.uz. Leave empty until you top up the account:
# registration works without SMS. Set both and phone OTP turns on automatically.
# ---------------------------------------------------------------------------
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
ESKIZ_SENDER=4546
# Optional secret for hashing OTP codes (falls back to the service role key)
OTP_HASH_SECRET=

# ---------------------------------------------------------------------------
# 3% booking deposit: the card customers send the deposit to (shown in the app).
# Without these, the booking page says the payment details are not configured.
# ---------------------------------------------------------------------------
ESCROW_CARD_NUMBER=
ESCROW_CARD_HOLDER=
ESCROW_BANK=

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
